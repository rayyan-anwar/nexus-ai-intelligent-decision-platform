# Copy to .env and replace placeholders. NEVER commit the real file.

# --- application ---
NEXUS_ENV=development                 # development | test | production
NEXUS_DATABASE_URL=sqlite:///./var/nexus.db   # PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
NEXUS_DATA_DIR=./var                  # uploaded datasets and model files live here
NEXUS_CORS_ORIGINS=http://localhost:5173      # comma-separated; never "*" in production
NEXUS_MAX_UPLOAD_MB=10
NEXUS_MAX_ROWS=200000
NEXUS_MAX_COLS=200
NEXUS_RATE_LIMIT_PER_MINUTE=120       # 0 disables
NEXUS_RETENTION_DAYS=30               # datasets are deleted after this many days; 0 = keep until deleted
NEXUS_TRAINING_WORKERS=1
NEXUS_LOG_LEVEL=INFO
NEXUS_TRUST_PROXY_HEADERS=false       # true only behind a trusted reverse proxy

# --- authentication (required in production) ---
# Generate with:  python scripts/create_token.py   (prints a token to keep, and its hash to put here)
NEXUS_API_TOKEN_HASHES=               # comma-separated SHA-256 hex digests
NEXUS_ADMIN_TOKEN_HASHES=

# --- docker compose ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nexus

# --- optional native accelerator ---
# NEXUS_DISABLE_ACCEL=1               # force the pure-Python path
# NEXUS_ACCEL_LIB=/path/to/libnexus_accel.so
